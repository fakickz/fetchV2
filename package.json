{
  "name": "fetchv2",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "fetch": ".venv/bin/python scripts/fetch.py --mode overviews",
    "fetch:overview": ".venv/bin/python scripts/fetch.py --mode overviews",
    "fetch:details": ".venv/bin/python scripts/fetch.py --mode urls",
    "api-gate": ".venv/bin/python scripts/api_gate.py",
    "discover": ".venv/bin/python scripts/discover.py",
    "basis": ".venv/bin/python scripts/basis.py",
    "basis:raw": ".venv/bin/python scripts/basis.py --text-source raw --output out/basis-raw.json --excluded out/basis-raw-excluded.csv --review out/basis-raw-review.csv",
    "basis:content": ".venv/bin/python scripts/basis.py --text-source content --output out/basis-content.json --excluded out/basis-content-excluded.csv --review out/basis-content-review.csv",
    "detail": ".venv/bin/python scripts/detail.py",
    "test": ".venv/bin/python -m unittest tests.test_pipeline_v2",
    "crawl": "npm run fetch:overview && npm run api-gate && npm run discover && npm run fetch:details",
    "v2": "npm run crawl && npm run basis && npm run detail"
  }
}
